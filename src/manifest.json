{
  "manifest_version": 3,
  "name": "Trust Ledger Client",
  "version": "1.4.2",
  "description": "An open-source protocol for accountable human-AI relationships.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
